{
  "brique": {
    "ctx_name": "e2e-node",
    "engine_version": "0.0.1",
    "ctx_version": "1",
    "ctx_ext_name": "node",
    "children_list": [
      "front",
      "back"
    ],
    "engine_config": {
      "communication": {
        "wrapper_boundary": [],
        "websocket_listener": {
          "addr": "127.0.0.1:0"
        },
        "interfaces": [
          {
            "name": "main",
            "type": "ui",
            "driver": "ws",
            "config": {
              "path": "/ws",
              "ingress_enabled": true,
              "egress_enabled": true
            }
          }
        ]
      },
      "execution": {
        "wrappers": []
      },
      "trace": {
        "enabled": true,
        "level": "debug",
        "ring_capacity": 64,
        "flush_every_n": 8,
        "flush_every_interval": 20,
        "segment_max_bytes": 1048576
      },
      "reflexive": {
        "root_repo": true,
        "repo_name": "brique-e2e-node"
      }
    }
  }
}
