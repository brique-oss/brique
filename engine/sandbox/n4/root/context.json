{
  "_comment": "Root context fixture for N4 inter-context routing tests.",
  "brique": {
    "ctx_name": "sandbox-n4-root",
    "engine_version": "0.0.1",
    "ctx_version": "1",
    "ctx_ext_name": "sandbox-n4-root",
    "children_list": [
      "alpha_parent",
      "beta_parent",
      "ui_owner",
      "wrapper_owner"
    ],
    "engine_config": {
      "communication": {
        "wrapper_boundary": [],
        "websocket_listener": {
          "addr": ":19181"
        },
        "interfaces": [
          {
            "name": "ui_root",
            "type": "ui",
            "driver": "ws",
            "config": {
              "ingress_enabled": true,
              "egress_enabled": true,
              "path": "/ui_root"
            }
          }
        ],
        "scattered": {
          "scattered_max_items": 8,
          "scattered_allowed": {
            "matter": [
              "matter.read"
            ],
            "reflexive": [
              "read.state"
            ]
          }
        }
      },
      "execution": {
        "wrappers": []
      },
      "trace": {
        "enabled": true,
        "level": "debug",
        "ring_capacity": 64,
        "flush_every_n": 8,
        "flush_every_interval": 20,
        "segment_max_bytes": 1048576
      },
      "reflexive": {
        "root_repo": true,
        "repo_name": "brique-sandbox-n4-root"
      }
    }
  },
  "objective": {
    "name": "sandbox-n4-root",
    "description": "Root fixture hosting multiple child contexts for N4 routing tests"
  },
  "functional": {
    "role": "root",
    "test_scope": [
      "inter-context routing",
      "root mediation",
      "remote boundary ownership"
    ]
  },
  "subjective": {
    "intent": "sandbox root fixture",
    "impression": "topology-focused"
  }
}
