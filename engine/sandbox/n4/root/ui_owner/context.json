{
  "_comment": "UI owner context for N4 routing tests.",
  "brique": {
    "ctx_name": "sandbox-n4-ui-owner",
    "engine_version": "0.0.1",
    "ctx_version": "1",
    "ctx_ext_name": "sandbox-n4-ui-owner",
    "children_list": [],
    "engine_config": {
      "communication": {
        "wrapper_boundary": [],
        "interfaces": [
          {
            "name": "ui_shared",
            "type": "ui",
            "driver": "ws",
            "config": {
              "ingress_enabled": true,
              "egress_enabled": true,
              "path": "/ui_shared"
            }
          }
        ],
        "scattered": {
          "scattered_max_items": 8,
          "scattered_allowed": {
            "matter": [
              "matter.read"
            ],
            "reflexive": [
              "reflexive.read"
            ]
          }
        }
      },
      "execution": {
        "wrappers": []
      },
      "trace": {
        "enabled": true,
        "level": "debug",
        "ring_capacity": 64,
        "flush_every_n": 8,
        "flush_every_interval": 20,
        "segment_max_bytes": 1048576
      },
      "reflexive": {
        "root_repo": false,
        "repo_name": "brique-sandbox-n4-ui-owner"
      }
    }
  },
  "objective": {
    "name": "sandbox-n4-ui-owner",
    "description": "Boundary owner for shared UI routing in N4 tests"
  },
  "functional": {
    "role": "boundary",
    "test_scope": [
      "local UI relay",
      "remote UI owner relay"
    ]
  },
  "subjective": {
    "intent": "ui owner",
    "impression": "boundary node"
  }
}
