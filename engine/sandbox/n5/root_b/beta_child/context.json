{
  "brique": {
    "ctx_name": "sandbox-n5-beta-child",
    "engine_version": "0.0.1",
    "ctx_version": "1",
    "ctx_ext_name": "beta-child",
    "children_list": [],
    "engine_config": {
      "communication": {
        "wrapper_boundary": [
          "sandbox_py"
        ],
        "interfaces": [
          {
            "name": "sandbox_py",
            "type": "wrapper",
            "driver": "ws",
            "config": {
              "ingress_enabled": true,
              "egress_enabled": true,
              "path": "/wrapper/sandbox_py"
            }
          }
        ]
      },
      "execution": {
        "wrappers": [
          {
            "wrapper_name": "sandbox_py",
            "mode": "interpreted",
            "ready_timeout_ms": 2000,
            "stop_timeout_ms": 1000,
            "build": {
              "shell": false,
              "timeout_ms": 1000,
              "artifact": "",
              "artifact_kind": "file",
              "cmd": []
            },
            "run": {
              "shell": false,
              "cmd": [
                "python3",
                "main.py"
              ],
              "env": {
                "BRIQUE_WRAPPER_NAME": "sandbox_py"
              }
            }
          }
        ]
      },
      "trace": {
        "enabled": true,
        "level": "debug",
        "ring_capacity": 64,
        "flush_every_n": 8,
        "flush_every_interval": 20,
        "segment_max_bytes": 1048576
      },
      "reflexive": {
        "root_repo": false,
        "repo_name": "brique-sandbox-n5-beta-child"
      }
    }
  }
}
