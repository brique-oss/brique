{
  "_comment": "Workspace child context used as mutable target for N6 functional tests.",
  "brique": {
    "ctx_name": "sandbox-n6-workspace",
    "engine_version": "0.0.1",
    "ctx_version": "1",
    "ctx_ext_name": "sandbox-n6-workspace",
    "children_list": [
      "chart_fr",
      "chart_us"
    ],
    "engine_config": {
      "communication": {
        "wrapper_boundary": [],
        "interfaces": [],
        "scattered": {
          "scattered_max_items": 8,
          "scattered_allowed": {
            "matter": [
              "matter.read"
            ],
            "reflexive": [
              "reflexive.read"
            ]
          }
        }
      },
      "execution": {
        "wrappers": []
      },
      "trace": {
        "enabled": true,
        "level": "debug",
        "ring_capacity": 64,
        "flush_every_n": 8,
        "flush_every_interval": 20,
        "segment_max_bytes": 1048576
      },
      "reflexive": {
        "root_repo": false,
        "repo_name": "brique-sandbox-n6-workspace"
      }
    }
  },
  "objective": {
    "name": "sandbox-n6-workspace",
    "description": "Mutable child context carrying seed descriptors for N6 functional tests"
  },
  "functional": {
    "role": "workspace",
    "test_scope": [
      "edit and read reflexive capabilities",
      "descriptor duplication and deletion",
      "meaning projection source material"
    ]
  },
  "subjective": {
    "intent": "mutable functional workspace",
    "impression": "seeded test context"
  }
}
